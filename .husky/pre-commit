#!/usr/bin/env sh

# attempt to load nvm if it exists, and select the node version specified in .nvmrc
NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use --silent
fi

# check if the node version is correct
ACTUAL_NODE_VERSION=$(node -v)
EXPECTED_NODE_VERSION=$(cat .nvmrc)
case "$ACTUAL_NODE_VERSION" in
  "v${EXPECTED_NODE_VERSION}" | "v${EXPECTED_NODE_VERSION}".*) ;;
  *)
    echo "[ERROR] Node version mismatch. Expected v${EXPECTED_NODE_VERSION}, but found ${ACTUAL_NODE_VERSION}."
    exit 1
    ;;
esac

npx lint-staged
