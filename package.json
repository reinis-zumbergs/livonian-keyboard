{
	"name": "keyboard",
	"version": "1.0.0",
	"description": "This Livonian keyboard layout is an expansion of the widely used Latvian (apostrophe) keyboard layout. With this layout apostrophe and backtick become dead keys for entering diacritics. The layout is designed to be used with the standard US keyboard layout.",
	"main": "index.js",
	"scripts": {
		"test": "jest",
		"linux-test": "python3 -I test/linux_layout_test.py && python3 -I test/linux_install_test.py",
		"bookmarklet-minify": "terser bookmarklet/livonian-keyboard.js -c -m > bookmarklet/livonian-keyboard.min.js",
		"bookmarklet-link": "node scripts/bookmarklet-link.js",
		"prettier": "prettier --write .",
		"prepare": "husky",
		"chrome-extension-prepare": "cp bookmarklet/livonian-keyboard.min.js chrome-extension/scripts/content.js",
		"chrome-extension-package": "rm -f livonian-keyboard-chrome-extension.zip && cd chrome-extension && zip -r ../livonian-keyboard-chrome-extension.zip . -x .gitkeep '*/.gitkeep'",
		"chrome-extension-all": "npm run chrome-extension-prepare && npm run chrome-extension-package"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"jsdom": "^26.1.0",
		"lint-staged": "^16.2.6",
		"prettier": "3.6.2",
		"terser": "^5.31.3"
	},
	"lint-staged": {
		"bookmarklet/livonian-keyboard.js": [
			"prettier --write",
			"bash -c 'npm run bookmarklet-minify'",
			"bash -c 'npm run bookmarklet-link'",
			"git add bookmarklet/livonian-keyboard.min.js bookmarklet/BOOKMARKLET.md"
		],
		"**/*": "prettier --write --ignore-unknown"
	}
}
